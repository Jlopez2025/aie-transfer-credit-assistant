# Copy to `.env` in this folder and fill in your values. Do NOT commit the real .env.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBED_DEPLOYMENT=
AZURE_OPENAI_RESEARCH_DEPLOYMENT=

# Folder of SNHU course OKF files (one .md per course)
SNHU_OKF_DIR=

# Live web search for missing descriptions; false shows "Live Agent Search Coming Soon"
LIVE_SEARCH=false
SEARCH_PROVIDERS=azure
ARCHIVE_FIRST=false
TAVILY_API_KEY=
BRAVE_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_API_URL=
ANTHROPIC_WORKSPACE_ID=
CLAUDE_RESEARCH_MODEL=
